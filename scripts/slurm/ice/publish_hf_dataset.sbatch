#!/usr/bin/env bash
#SBATCH --job-name=lewm-hf-publish
#SBATCH --output=logs/ice/%x-%j.out
#SBATCH --error=logs/ice/%x-%j.err
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=8G
#SBATCH --time=12:00:00

set -euo pipefail

# `hf auth login` stores credentials below the login node's cache.  The common
# ICE runtime intentionally redirects ordinary caches into STABLEWM_HOME, which
# would otherwise hide that credential from compute jobs.  Prefer the logged-in
# cache when the submitter did not explicitly inject HF_HOME or HF_TOKEN.
if [[ -z "${HF_HOME:-}" && -z "${HF_TOKEN:-}" ]]; then
  for hf_login_home in \
    "$HOME/scratch/.cache/huggingface" \
    "$HOME/.cache/huggingface"; do
    if [[ -s "$hf_login_home/token" || -s "$hf_login_home/stored_tokens" ]]; then
      export HF_HOME="$hf_login_home"
      break
    fi
  done
fi

REPO_DIR="${REPO_DIR:-${SLURM_SUBMIT_DIR:-$(pwd)}}"
SCRIPT_DIR="$REPO_DIR/scripts/slurm/ice"
source "$SCRIPT_DIR/common.sh"
prepare_lewm_runtime

: "${HF_DATASET_REPO:?Set HF_DATASET_REPO to the destination dataset repo}"
: "${HF_ARTIFACT_PREFIX:?Set HF_ARTIFACT_PREFIX to an immutable path in the repo}"
: "${HF_ARTIFACTS:?Set HF_ARTIFACTS to a whitespace-separated artifact list}"

# Accept either a securely injected HF_TOKEN or an existing `hf auth login`
# credential in HF_HOME. Never print either credential into the Slurm log.
if ! "$PIXI_BIN" run --locked python -c \
  'from huggingface_hub import HfApi; HfApi().whoami()' >/dev/null 2>&1; then
  echo "Hugging Face authentication is unavailable in HF_HOME; refusing upload" >&2
  exit 2
fi

print_run_metadata
echo "hf_dataset_repo=$HF_DATASET_REPO"
echo "hf_artifact_prefix=$HF_ARTIFACT_PREFIX"

# Paths are generated by our own jobs and intentionally do not contain spaces.
read -r -a artifact_paths <<< "$HF_ARTIFACTS"
srun "$PIXI_BIN" run --locked python -u scripts/data/publish_hf_dataset.py \
  --repo "$HF_DATASET_REPO" \
  --prefix "$HF_ARTIFACT_PREFIX" \
  "${artifact_paths[@]}"
